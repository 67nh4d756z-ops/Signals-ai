with tab_data:
    st.subheader("2. Optional: validate a model using historical candles")
    st.write("Upload OHLCV CSV data to test a machine-learning model. This is separate from screenshot-only review.")
    uploads = st.file_uploader(
        "Upload one or more historical 5-minute CSV files",
        type=["csv"], accept_multiple_files=True, key="historical_uploads"
    )
    if uploads:
        selected_name = st.selectbox("Choose asset dataset", [f.name for f in uploads])
        selected_file = next(f for f in uploads if f.name == selected_name)
        try:
            df = normalize_csv(selected_file)
            c1, c2, c3 = st.columns(3)
            c1.metric("Candles", f"{len(df):,}")
            c2.metric("First row", str(df["timestamp"].iloc[0]))
            c3.metric("Last row", str(df["timestamp"].iloc[-1]))
            horizon = st.selectbox("Prediction horizon in candles", [1, 2, 3], index=0)
            test_fraction = st.slider("Chronological test fraction", 0.15, 0.40, 0.25, 0.05)
            threshold = st.slider("Signal threshold", 0.50, 0.90, 0.65, 0.01)
            payout_pct = st.slider("Net winning payout (%)", 40, 95, 80, 1)
            stake = st.number_input("Hypothetical stake per signal (â¹)", min_value=1.0, value=100.0, step=50.0)
            if st.button("Run out-of-sample test"):
                data = make_features(df, horizon).dropna(subset=["target"]).copy()
                data["target"] = data["target"].astype(int)
                data = data.dropna(subset=["ret_1", "ret_2", "ret_3", "ret_6", "ret_12"])
                split = int(len(data) * (1 - test_fraction))
                train, test = data.iloc[:split], data.iloc[split:]
                if len(train) < 100 or len(test) < 30 or train["target"].nunique() < 2:
                    st.error("Not enough usable data or only one training class. Upload more history.")
                else:
                    model = new_model()
                    model.fit(train[FEATURES], train["target"])
                    classes = list(model.named_steps["model"].classes_)
                    prob_up = model.predict_proba(test[FEATURES])[:, classes.index(1)]
                    pred = (prob_up >= 0.5).astype(int)
                    threshold_value = threshold
                    signals = np.where(prob_up >= threshold_value, "CALL",
                               np.where(prob_up <= 1 - threshold_value, "PUT", "NO TRADE"))
                    active_mask = signals != "NO TRADE"
                    active_idx = np.flatnonzero(active_mask)
                    wins = []
                    pnl = []
                    for i in active_idx:
                        actual_up = int(test["target"].iloc[i]) == 1
                        won = actual_up if signals[i] == "CALL" else not actual_up
                        wins.append(won)
                        pnl.append((payout_pct / 100 * stake) if won else -stake)
                    win_rate = float(np.mean(wins)) if wins else float("nan")
                    breakeven = 1 / (1 + payout_pct / 100)
                    net_pnl = float(np.sum(pnl)) if pnl else 0.0
                    roi = net_pnl / (len(pnl) * stake) if pnl else float("nan")
                    m1, m2, m3, m4 = st.columns(4)
                    m1.metric("Test candles", f"{len(test):,}")
                    m2.metric("Directional accuracy", f"{accuracy_score(test['target'], pred):.1%}")
                    m3.metric("Balanced accuracy", f"{balanced_accuracy_score(test['target'], pred):.1%}")
                    m4.metric("Signal coverage", f"{np.mean(active_mask):.1%}")
                    m1, m2, m3, m4 = st.columns(4)
                    m1.metric("Signals", str(len(active_idx)))
                    m2.metric("Signal win rate", "â" if math.isnan(win_rate) else f"{win_rate:.1%}")
                    m3.metric("Break-even win rate", f"{breakeven:.1%}")
                    m4.metric("Hypothetical net P/L", f"â¹{net_pnl:,.2f}")
                    m1, m2, m3 = st.columns(3)
                    m1.metric("Hypothetical ROI", "â" if math.isnan(roi) else f"{roi:.1%}")
                    m2.metric("Brier score (lower is better)", f"{brier_score_loss(test['target'], prob_up):.3f}")
                    m3.metric("Log loss (lower is better)", f"{log_loss(test['target'], np.clip(prob_up, 1e-6, 1-1e-6), labels=[0,1]):.3f}")
                    st.caption(f"At {payout_pct}% net payout, break-even win rate is {breakeven:.1%}, before execution differences.")
                    st.warning("This is one chronological holdout, not proof of a durable edge. Do not tune settings against this test set and then report it as independent.")
                    out = test[["timestamp", "close", "target"]].copy()
                    out["probability_up"] = prob_up
                    out["probability_down"] = 1 - prob_up
                    out["signal"] = signals
