REQUIRED = {"open", "high", "low", "close"}


def normalize_csv(file):
    df = pd.read_csv(file)
    df.columns = [str(c).strip().lower().replace(" ", "_") for c in df.columns]
    aliases = {"date": "timestamp", "datetime": "timestamp", "time": "timestamp",
               "tick_volume": "volume", "vol": "volume"}
    df = df.rename(columns={k: v for k, v in aliases.items() if k in df.columns})
    missing = REQUIRED - set(df.columns)
    if missing:
        raise ValueError(f"Missing columns: {', '.join(sorted(missing))}")
    for c in ["open", "high", "low", "close", "volume"]:
        if c in df.columns:
            df[c] = pd.to_numeric(df[c], errors="coerce")
    if "volume" not in df.columns:
        df["volume"] = 0.0
    if "timestamp" in df.columns:
        df["timestamp"] = pd.to_datetime(df["timestamp"], errors="coerce", utc=True)
        df = df.sort_values("timestamp")
    else:
        df["timestamp"] = np.arange(len(df))
    df = df.dropna(subset=["open", "high", "low", "close"])
    df = df.drop_duplicates(subset=["timestamp"], keep="last").reset_index(drop=True)
    if len(df) < 150:
        raise ValueError("Upload at least 150 candles; several thousand are preferable.")
    return df


def make_features(df, horizon):
    x = df.copy()
    close, high, low, opn = x["close"], x["high"], x["low"], x["open"]
    for n in [1, 2, 3, 6, 12]:
        x[f"ret_{n}"] = close.pct_change(n)
    ema9 = close.ewm(span=9, adjust=False).mean()
    ema21 = close.ewm(span=21, adjust=False).mean()
    ema50 = close.ewm(span=50, adjust=False).mean()
    x["ema_gap_9_21"] = (ema9 - ema21) / close.replace(0, np.nan)
    x["ema_gap_21_50"] = (ema21 - ema50) / close.replace(0, np.nan)
    delta = close.diff()
    gain = delta.clip(lower=0).ewm(alpha=1/14, adjust=False).mean()
    loss = (-delta.clip(upper=0)).ewm(alpha=1/14, adjust=False).mean()
    rs = gain / loss.replace(0, np.nan)
    x["rsi_14"] = 100 - (100 / (1 + rs))
    macd = close.ewm(span=12, adjust=False).mean() - close.ewm(span=26, adjust=False).mean()
    x["macd_norm"] = macd / close.replace(0, np.nan)
    candle_range = (high - low).replace(0, np.nan)
    x["range_norm"] = (high - low) / close.replace(0, np.nan)
    x["body_norm"] = (close - opn) / close.replace(0, np.nan)
    x["upper_wick_norm"] = (high - np.maximum(opn, close)) / close.replace(0, np.nan)
    x["lower_wick_norm"] = (np.minimum(opn, close) - low) / close.replace(0, np.nan)
    x["volatility_12"] = close.pct_change().rolling(12).std()
    x["volume_change"] = x["volume"].pct_change().replace([np.inf, -np.inf], np.nan)
    x["close_location"] = ((close - low) / candle_range).clip(0, 1)
    future = close.shift(-horizon)
    x["target"] = (future > close).astype(float)
    x.loc[future.isna(), "target"] = np.nan
    x[FEATURES] = x[FEATURES].replace([np.inf, -np.inf], np.nan)
    return x


def new_model():
    return Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("model", HistGradientBoostingClassifier(
            max_iter=150, learning_rate=0.06, max_leaf_nodes=15,
            l2_regularization=2.0, random_state=42
        ))
    ])


